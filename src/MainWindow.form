          <Properties>
            <Property name="columns" type="int" value="20"/>
            <Property name="rows" type="int" value="5"/>
            <Property name="text" type="java.lang.String" value="Hier steht mehrzeiliger Text.&#xa;Durch den Button &quot;Suchen&quot; kann man sich den Suchtext&#xa;aus dem Feld &quot;tfSuchen&quot; im Editorfeld finden lassen.&#xa;&#xa;Der &quot;Suchtext&quot; soll dann markiert werden.&#xa;&#xa;Ein Text wie &quot;SuChTeXt&quot; l&#xe4;sst sich nur finden,&#xa;wenn &quot;Gro&#xdf;schreibung ignorieren&quot; ausgew&#xe4;hlt ist."/>
          </Properties>
        </Component>
      </SubComponents>
    </Container>
